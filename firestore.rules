rules_version = '2';

// Publique este arquivo em: Firebase Console > Firestore Database > Regras > Publicar

service cloud.firestore {
  match /databases/{database}/documents {

    match /carteira/{itemId} {

      // Só permite LER se estiver logado E o documento pertencer ao usuário logado
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // Só permite CRIAR se estiver logado, o userId enviado bater com quem está criando,
      // e os campos essenciais existirem com o tipo certo
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.valor is number
                    && request.resource.data.valor > 0
                    && request.resource.data.data is string
                    && request.resource.data.tipo in ['ENTRADA', 'SAIDA']
                    && request.resource.data.tipo_mov in ['INTERNO', 'EXTERNO'];

      // Permite EXCLUIR apenas o próprio dono do lançamento
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;

      // Edição continua bloqueada (evita alterar histórico por engano).
      // Se um dia quiser permitir editar, troque para uma regra "allow update" própria.
      allow update: if false;
    }

    // Bloqueia qualquer outra coleção não prevista explicitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
