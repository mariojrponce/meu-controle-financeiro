rules_version = '2';

// Publique este arquivo com: firebase deploy --only firestore:rules
// (ou manualmente em Firebase Console > Firestore Database > Regras > Publicar)

service cloud.firestore {
  match /databases/{database}/documents {

    // Valida os campos de texto livre: tipo string e tamanho máximo igual ao
    // maxlength dos formulários (index.html/editor-transacao.js). descricao,
    // banco e classificacao_saida são obrigatórios na UI (não podem chegar
    // vazios); saida (detalhe) é opcional e pode ser "".
    function camposDeTextoValidos(dados) {
      return dados.descricao is string && dados.descricao.size() > 0 && dados.descricao.size() <= 120
             && dados.saida is string && dados.saida.size() <= 120
             && dados.banco is string && dados.banco.size() > 0 && dados.banco.size() <= 60
             && dados.classificacao_saida is string && dados.classificacao_saida.size() > 0 && dados.classificacao_saida.size() <= 60;
    }

    // Só os campos que o sistema grava — qualquer outro é recusado.
    function camposPermitidos(dados) {
      return dados.keys().hasOnly([
        'userId', 'valor', 'data', 'tipo', 'tipo_mov', 'descricao', 'saida', 'banco',
        'classificacao_saida', 'criadoEm',
        'investimento', 'dono_carteira', 'banco_investimento',   // tela Investimentos
        'importacao_id', 'id_externo', 'texto_banco',             // importação de extratos
        'recorrencia_id', 'ocorrencia'                            // despesas recorrentes
      ]);
    }

    // Campo opcional: pode não existir, ser nulo ou ser um texto de até `maximo` caracteres.
    function textoOpcional(dados, campo, maximo) {
      return !(campo in dados) || dados[campo] == null
             || (dados[campo] is string && dados[campo].size() <= maximo);
    }

    // Valor positivo com teto, data no formato aaaa-mm-dd e campos opcionais com tamanho limitado.
    function lancamentoValido(dados) {
      return camposPermitidos(dados)
             && dados.valor is number && dados.valor > 0 && dados.valor <= 1000000000
             && dados.data is string && dados.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && dados.tipo in ['ENTRADA', 'SAIDA']
             && dados.tipo_mov in ['INTERNO', 'EXTERNO']
             && camposDeTextoValidos(dados)
             && (!('criadoEm' in dados) || dados.criadoEm is timestamp)
             && textoOpcional(dados, 'investimento', 60)
             && textoOpcional(dados, 'dono_carteira', 60)
             && textoOpcional(dados, 'banco_investimento', 60)
             && textoOpcional(dados, 'importacao_id', 200)
             && textoOpcional(dados, 'id_externo', 300)
             && textoOpcional(dados, 'texto_banco', 300)
             && textoOpcional(dados, 'recorrencia_id', 80)
             && textoOpcional(dados, 'ocorrencia', 7);
    }

    match /carteira/{itemId} {

      // Só permite LER se estiver logado E o documento pertencer ao usuário logado
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // Só permite CRIAR se estiver logado, o userId enviado bater com quem está criando,
      // e os campos essenciais existirem com o tipo, tamanho e formato certos
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && lancamentoValido(request.resource.data);

      // Permite EDITAR apenas o próprio dono do lançamento, mantendo os
      // mesmos campos essenciais válidos depois da edição. O userId não pode
      // mudar na edição — senão o dono conseguiria "abandonar" o documento
      // atribuindo-o a outro uid, tornando-o ilegível/inedável por qualquer um.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && lancamentoValido(request.resource.data);

      // Permite EXCLUIR apenas o próprio dono do lançamento
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // Configurações de cada usuário (tela Configurações): um documento cujo ID é
    // o próprio uid. Só o dono lê e grava; só as listas previstas, com tamanho limitado.
    function listaValida(dados, campo) {
      return dados[campo] is list && dados[campo].size() <= 300;
    }

    match /configuracoes/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['bancos', 'classificacoes', 'bancosVale', 'regras', 'recorrencias', 'atualizadoEm'])
                            && listaValida(request.resource.data, 'bancos')
                            && listaValida(request.resource.data, 'classificacoes')
                            && listaValida(request.resource.data, 'bancosVale')
                            && listaValida(request.resource.data, 'regras')
                            && listaValida(request.resource.data, 'recorrencias');
    }

    // Bloqueia qualquer outra coleção não prevista explicitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
